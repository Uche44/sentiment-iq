{
  "name": "sentiment-system",
  "version": "1.0.0",
  "description": "Web-based sentiment analysis system for e-commerce customer feedback",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:init": "node scripts/db-init.js",
    "seed": "node db/seed.js",
    "import": "node scripts/import-reviews.js",
    "engine:once": "node scripts/run-engine-once.js",
    "test": "jest --runInBand",
    "evaluate": "node evaluation/evaluate.js",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0",
    "stopword": "^3.0.0",
    "vader-sentiment": "^1.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "prettier": "^3.9.10",
    "supertest": "^7.0.0"
  }
}
